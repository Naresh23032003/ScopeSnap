# ==============================================================================
# ScopeSnap Environment Template
# Copy this file to .env.local and populate with your credentials
# ==============================================================================

# Groq Cloud API Key (Get a free API key at https://console.groq.com)
# Used server-side in /api/generate-scope for llama-3.3-70b-versatile inference
GROQ_API_KEY=gsk_your_key_here

# Public URL of the deployed application (Optional, defaults to localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Checkout URL for $9 Pro Custom Agency Branding (Optional)
NEXT_PUBLIC_PRO_CHECKOUT_URL=https://buy.stripe.com/mock_scopesnap_pro
